# Python environments and tool caches
__pycache__/
*.py[cod]
.venv*/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage*
htmlcov/
.cache/
.benchmarks/
.agents/
.claude
.sisyphus/
.cognee-data/

# Local credentials; keep documented templates trackable
.env
.env.*
!.env.example
!.env.sample

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Builds and compiler output; native layout inputs under layout/ stay tracked
/build/
/build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
/Makefile
/Testing/
*.obj
*.o
*.pdb
*.ilk
*.idb
*.pch
*.exp
*.sbr
*.bsc
*.map
/*.exe
/*.dll
*.log
*.cod
compile_commands.json

# Local references, extracted bytes, experiments and source backups
/original/
/bin/
/output/
/run_out/
/.scratch/
/source-backups/
/binsync/
/.rebrew/
/rebrew-rsp-*/
/flirt_sigs/
*.bak
*.tmp
*.orig
*.rej
/__mc_tmp.c
/diff_*.txt
/ga_*.txt
/fix_*.py
/score_*.txt
/flag_sweep_output.txt
/cand.c
/cand_swap.c

# Keep native inventories, ignore generated coverage/database files
/db/*
!/db/inventory-*.json
/catalog.json
/diff.json
/reccmp-build.yml
/reccmp-user.yml
/reccmp-progress.svg
/reccmp-report.html
/reccmp-summary.json
/reccmp-*-orig.txt
/reccmp-*-recomp.txt

# Downloaded SDK/tool inputs; source manifests and provenance remain tracked
/tools/ghidra-cli
/references/dxsdk8/
/references/mss-6.0/*.lib
/references/mss-6.1c/*.lib

# Managed-store locks are local; the TOML stores themselves are tracked
/rebrew-functions.toml.lock
/rebrew-data.toml.lock
/rebrew-source.toml.lock
/rebrew-types.toml.lock
/rebrew-project.toml.lock
