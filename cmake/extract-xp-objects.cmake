if(NOT DEFINED XP_ARCHIVE OR NOT EXISTS "${XP_ARCHIVE}")
  message(FATAL_ERROR "Provide the pristine XP SP1 D3DX8 archive at ${XP_ARCHIVE} (SHA-256 c02e4fedf3e2e0964a1eed98ca02b28d68a0a7ac184594b04212216253bfbd9d)")
endif()
file(SHA256 "${XP_ARCHIVE}" _xp_archive_hash)
if(NOT _xp_archive_hash STREQUAL "c02e4fedf3e2e0964a1eed98ca02b28d68a0a7ac184594b04212216253bfbd9d")
  message(FATAL_ERROR "Unexpected XP SP1 D3DX8 archive SHA-256: ${_xp_archive_hash}")
endif()
if(NOT DEFINED XP_AR OR NOT DEFINED XP_OUTPUT_DIR OR XP_OUTPUT_DIR STREQUAL "")
  message(FATAL_ERROR "XP_AR and XP_OUTPUT_DIR are required")
endif()
file(MAKE_DIRECTORY "${XP_OUTPUT_DIR}")
foreach(_xp_member IN ITEMS cd3dximage jerror)
  if(_xp_member STREQUAL "cd3dximage")
    set(_xp_expected "d0c91f1bf7550ae39709f738416a48710e75aba61749203d8c7b03d5a07fe592")
  else()
    set(_xp_expected "e1203fbdc8cb43231d4952b24843030fdd4f332c51e858807bdaf6cbda0516ba")
  endif()
  set(_xp_temp "${XP_OUTPUT_DIR}/xp-${_xp_member}.obj.tmp")
  execute_process(COMMAND "${XP_AR}" p "${XP_ARCHIVE}" "obj\\i386\\${_xp_member}.obj"
    OUTPUT_FILE "${_xp_temp}" RESULT_VARIABLE _xp_extract_rc)
  if(NOT _xp_extract_rc EQUAL 0)
    file(REMOVE "${_xp_temp}")
    message(FATAL_ERROR "Failed to extract XP SP1 ${_xp_member}.obj")
  endif()
  file(SHA256 "${_xp_temp}" _xp_actual)
  if(NOT _xp_actual STREQUAL _xp_expected)
    file(REMOVE "${_xp_temp}")
    message(FATAL_ERROR "Unexpected XP SP1 ${_xp_member}.obj SHA-256: ${_xp_actual}")
  endif()
endforeach()
# Publish only after both members pass, so failures leave prior objects intact.
foreach(_xp_member IN ITEMS cd3dximage jerror)
  file(RENAME "${XP_OUTPUT_DIR}/xp-${_xp_member}.obj.tmp"
    "${XP_OUTPUT_DIR}/xp-${_xp_member}.obj")
endforeach()
