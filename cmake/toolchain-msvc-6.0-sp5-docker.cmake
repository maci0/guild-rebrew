# CMake toolchain file for msvc-6.0-sp5 via the rebrew docker image (wine inside).
# Generated by `rebrew build cmake-toolchain --toolchain msvc-6.0-sp5` — do not hand-edit.
#
# rebrew build driver cl/link/lib translates CMake invocations into
# docker runs against rebrew/msvc:6.0-sp5-win32.
# Build the image first:  rebrew toolchain build msvc-6.0-sp5
#
# Usage:
#   cmake -B build --toolchain cmake/toolchain-msvc-6.0-sp5-docker.cmake -DCMAKE_BUILD_TYPE=Release
#   cmake --build build -j8

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)

find_program(_REBREW_EXECUTABLE NAMES rebrew)
if(NOT _REBREW_EXECUTABLE)
  message(FATAL_ERROR "rebrew not found on PATH; activate the Rebrew environment")
endif()
set(CMAKE_C_COMPILER "${_REBREW_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 "build driver cl --")
set(CMAKE_LINKER "${_REBREW_EXECUTABLE}")
set(CMAKE_AR "${_REBREW_EXECUTABLE}")
set(REBREW_CMAKE_AR_COMMAND "${_REBREW_EXECUTABLE}" build driver lib --)
set(CMAKE_USER_MAKE_RULES_OVERRIDE_C "${CMAKE_CURRENT_LIST_DIR}/rules-msvc-6.0-sp5-docker.cmake")

set(CMAKE_C_COMPILER_ID "MSVC" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER_VERSION "12.00.8966" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_C_COMPILER_WORKS TRUE CACHE BOOL "" FORCE)

set(CMAKE_SIZEOF_VOID_P 4 CACHE STRING "" FORCE)

set(CMAKE_C_OUTPUT_EXTENSION ".obj")
set(CMAKE_STATIC_LIBRARY_PREFIX "")
set(CMAKE_STATIC_LIBRARY_SUFFIX ".lib")
set(CMAKE_SHARED_LIBRARY_PREFIX "")
set(CMAKE_SHARED_LIBRARY_SUFFIX ".dll")
set(CMAKE_IMPORT_LIBRARY_PREFIX "")
set(CMAKE_IMPORT_LIBRARY_SUFFIX ".lib")
set(CMAKE_EXECUTABLE_SUFFIX ".exe")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
