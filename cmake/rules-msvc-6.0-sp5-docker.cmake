# Generated by rebrew build cmake-toolchain; preserves CMake's MSVC rules.
foreach(rule CREATE_SHARED_LIBRARY CREATE_SHARED_MODULE LINK_EXECUTABLE)
  string(REPLACE "<CMAKE_LINKER>" "<CMAKE_LINKER> build driver link -- /REBREW_TOOLCHAIN:msvc-6.0-sp5"
    CMAKE_C_${rule} "${CMAKE_C_${rule}}")
endforeach()
foreach(rule CREATE_STATIC_LIBRARY CREATE_STATIC_LIBRARY_IPO)
  string(REPLACE "<CMAKE_AR>" "<CMAKE_AR> build driver lib -- /REBREW_TOOLCHAIN:msvc-6.0-sp5"
    CMAKE_C_${rule} "${CMAKE_C_${rule}}")
endforeach()
