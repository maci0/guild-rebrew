#!/bin/bash
# Docker wrapper for MSVC 6.0 CL.EXE — used as CMAKE_C_COMPILER.
# Runs CL.EXE inside the rebrew/msvc:6.0-win32 docker image (wine inside).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/msvc6-wine-common.sh"

args=()
for arg in "$@"; do
    case "$arg" in
        /I*) dir="${arg#/I}"; [[ "$dir" == /* ]] && dir="$(msvc_to_w "$dir")"; args+=("/I$dir") ;;
        /Fo*) p="${arg#/Fo}"; [[ "$p" == *".obj"* ]] && { [[ "$p" == /* ]] && p="$(msvc_to_w "$p")" || { [[ "$p" == *.obj ]] && p="$(msvc_to_w "$(pwd)/$p")"; }; }; args+=("/Fo$p") ;;
        /Fd*) p="${arg#/Fd}"; [[ "$p" == /* ]] && p="$(msvc_to_w "$p")" || { [[ -n "$p" && "$p" != "-" ]] && p="$(msvc_to_w "$(pwd)/$p")"; }; args+=("/Fd$p") ;;
        /Fe*) p="${arg#/Fe}"; [[ "$p" == /* ]] && p="$(msvc_to_w "$p")"; args+=("/Fe$p") ;;
        /Fp*) p="${arg#/Fp}"; [[ "$p" == /* ]] && p="$(msvc_to_w "$p")"; args+=("/Fp$p") ;;
        /*.c|/*.cpp|/*.cc|/*.cxx) args+=("$(msvc_to_w "$arg")") ;;
        /home/*|/tmp/*|/gamatcher/*) args+=("$(msvc_to_w "$arg")") ;;
        *) args+=("$arg") ;;
    esac
done
msvc_docker_run CL.EXE "${args[@]}"
