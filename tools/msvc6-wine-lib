#!/bin/bash
# Docker wrapper for MSVC 6.0 LIB.EXE — used as CMAKE_AR.
# Runs LIB.EXE inside the rebrew/msvc:6.0-win32 docker image (wine inside).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/msvc6-wine-common.sh"

args=()
for arg in "$@"; do
    case "$arg" in
        /OUT:/*) p="${arg#/OUT:}"; args+=("/OUT:$(msvc_to_w "$p")") ;;
        /home/*|/tmp/*|/gamatcher/*) args+=("$(msvc_to_w "$arg")") ;;
        /*.obj|/*.lib) args+=("$(msvc_to_w "$arg")") ;;
        *) args+=("$arg") ;;
    esac
done
msvc_docker_run LIB.EXE "${args[@]}"
