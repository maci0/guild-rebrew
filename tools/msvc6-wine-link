#!/bin/bash
# Docker wrapper for MSVC 6.0 LINK.EXE — used as CMAKE_LINKER.
# Runs LINK.EXE inside the rebrew/msvc:6.0-win32 docker image (wine inside).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/msvc6-wine-common.sh"

args=()
for arg in "$@"; do
    case "$arg" in
        /[Oo][Uu][Tt]:*) p="${arg#*:}"; args+=("/OUT:$(msvc_to_w "$p")") ;;
        /[Dd][Ee][Ff]:*) p="${arg#*:}"; args+=("/DEF:$(msvc_to_w "$p")") ;;
        /[Ll][Ii][Bb][Pp][Aa][Tt][Hh]:*) p="${arg#*:}"; args+=("/LIBPATH:$(msvc_to_w "$p")") ;;
        /[Ii][Mm][Pp][Ll][Ii][Bb]:*) p="${arg#*:}"; args+=("/IMPLIB:$(msvc_to_w "$p")") ;;
        /[Pp][Dd][Bb]:*) p="${arg#*:}"; args+=("/PDB:$(msvc_to_w "$p")") ;;
        /[Mm][Aa][Pp]:*) p="${arg#*:}"; args+=("/MAP:$(msvc_to_w "$p")") ;;
        /home/*|/tmp/*|/gamatcher/*) args+=("$(msvc_to_w "$arg")") ;;
        /*.obj|/*.lib) args+=("$(msvc_to_w "$arg")") ;;
        *) args+=("$arg") ;;
    esac
done
msvc_docker_run LINK.EXE "${args[@]}"
